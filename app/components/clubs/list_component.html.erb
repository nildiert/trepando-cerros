<% if @clubs.any? %>
  <div class="overflow-x-auto">
    <table class="table w-full">
      <thead>
        <tr>
          <th>Nombre</th>
          <th>Descripción</th>
          <th>Entrenadores</th>
          <th>Atletas</th>
          <th>Acciones</th>
        </tr>
      </thead>
      <tbody>
        <% @clubs.each do |club| %>
          <tr>
            <td class="font-medium"><%= club.name %></td>
            <td><%= club.description %></td>
            <td><%= club.coaches.map { |c| c.full_name.presence || c.email }.to_sentence.presence || '-' %></td>
            <td>
              <%= link_to club.users.joins(:role).where(roles: { name: 'normal' }).count, athletes_path, class: 'link link-primary' %>
            </td>
            <td>
              <% if helpers.can? :manage, Club %>
                <%= link_to club_path(club), method: :delete, data: { turbo_confirm: '¿Eliminar club?' }, class: 'text-error', title: 'Eliminar' do %>
                  <i class="fa-solid fa-trash"></i>
                <% end %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <p class="text-gray-600">No hay clubes registrados.</p>
<% end %>
