<div class="card bg-base-100 shadow">
  <div class="card-body">
    <h2 class="text-xl font-semibold mb-4">
      Atletas <%= @club ? "de #{@club.name}" : 'del Club' %>
    </h2>
    <% if @athletes.any? %>
      <ul class="list-disc pl-5">
        <% @athletes.each do |athlete| %>
          <li>
            <%= link_to athlete.full_name.presence || athlete.email,
                        user_path(athlete),
                        class: 'link link-primary' %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="text-gray-600">No hay atletas disponibles.</p>
    <% end %>
  </div>
</div>
