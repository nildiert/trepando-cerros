<div class="card bg-base-100 shadow">
  <div class="card-body">
        <h2 class="text-xl font-semibold mb-4">Clubes</h2>
        <% if @clubs.any? %>
          <ul class="list-disc pl-5 space-y-2">
            <% @clubs.each do |club| %>
              <li>
                <h3 class="font-medium"><%= club.name %></h3>
                <p class="text-gray-600"><%= club.description %></p>
              </li>
            <% end %>
          </ul>
        <% else %>
          <p class="text-gray-600">No hay clubes registrados.</p>
        <% end %>
      </div>
    </div>
