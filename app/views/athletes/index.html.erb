<div class="card bg-base-100 shadow">
  <div class="card-body">
        <h2 class="text-xl font-semibold mb-4">Atletas del Club</h2>
        <% if @athletes.any? %>
          <ul class="list-disc pl-5">
            <% @athletes.each do |athlete| %>
              <li><%= athlete.full_name.presence || athlete.email %></li>
            <% end %>
          </ul>
        <% else %>
          <p class="text-gray-600">No hay atletas disponibles.</p>
        <% end %>
      </div>
    </div>
