<div class="card bg-base-100 shadow">
  <div class="card-body">
        <h2 class="text-xl font-semibold mb-4">Entrenadores Disponibles</h2>
        <% if @coaches.any? %>
          <ul class="list-disc pl-5">
            <% @coaches.each do |coach| %>
              <li><%= coach.full_name.presence || coach.email %></li>
            <% end %>
          </ul>
        <% else %>
          <p class="text-gray-600">No hay entrenadores disponibles.</p>
        <% end %>
      </div>
    </div>
